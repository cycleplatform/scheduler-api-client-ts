{
    "name": "@cycleplatform/scheduler-api-client",
    "version": "0.3.0",
    "description": "Cycle scheduler service API client",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "test": "vitest run --passWithNoTests",
        "test:ts": "tsc --noEmit",
        "generate:types": "openapi-typescript ./api-spec/scheduler/api.yml --output ./src/generated/types.ts",
        "build:lib": "npm run generate:types && vite build",
        "prepare": "vite build",
        "prepublishOnly": "npm run build:lib"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cycleplatform/scheduler-api-client-ts.git"
    },
    "keywords": [
        "cycleplatform",
        "api",
        "client",
        "scheduler"
    ],
    "author": "Petrichor, Inc.",
    "license": "Apache-2.0",
    "dependencies": {
        "openapi-fetch": "0.17.0",
        "undici": "^8.5.0"
    },
    "devDependencies": {
        "msw": "2.14.6",
        "openapi-typescript": "7.13.0",
        "vite-plugin-dts": "5.0.2",
        "typescript": "5.9.3",
        "vite": "8.0.16",
        "vitest": "4.1.9"
    }
}
